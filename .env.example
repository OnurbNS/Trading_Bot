# =============================================================================
# Trading Bot — variáveis de ambiente (exemplo sem segredos)
# Copie para .env e preencha localmente. Nunca versione o arquivo .env.
# =============================================================================

# Ambiente: development | test | production
APP_ENV=development

# Modo operacional. MVP: somente paper.
APP_MODE=paper

APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Supabase (preencher a partir da Fase 2). SERVICE_ROLE_KEY somente no backend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Market data (adapter modular). Sem chave privada no frontend.
MARKET_DATA_PROVIDER=binance_public
MARKET_DATA_API_KEY=

DEFAULT_QUOTE_ASSET=USDT
DEFAULT_SYMBOLS=BTC/USDT,ETH/USDT
DEFAULT_TIMEFRAME=5m

# Paper trading — valores de demonstração (sem dinheiro real)
PAPER_INITIAL_BALANCE=100.00
PAPER_FEE_RATE=0.001
PAPER_SLIPPAGE_BPS=5

# Execução: desabilitada por padrão. LIVE deve permanecer false nesta versão.
TRADING_ENABLED=false
LIVE_TRADING_ENABLED=false

# Qualidade de dados — bloquear operação se atraso exceder o limite (segundos)
MARKET_DATA_MAX_AGE_SECONDS=120
